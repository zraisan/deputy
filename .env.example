# Deputy — local secrets. Never committed.

# Deputy's own model, via OpenRouter. It reads pages inside the browser and
# answers questions about them, so Claude never has to look at the page.
OPENROUTER_API_KEY=

# Which model Deputy thinks with. Anything OpenRouter serves.
# The job is page reading + schema-constrained tool selection, so favour
# something fast and cheap over something clever.
OPENROUTER_MODEL=qwen/qwen3.7-flash

# Optional. Sent to OpenRouter for attribution on their dashboard.
# OPENROUTER_SITE_NAME=Deputy

# Optional. Stable signing key for MCP requestState (generated per run if unset).
# DEPUTY_STATE_KEY=
